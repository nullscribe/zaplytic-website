---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AnimatedBackground from "@/components/AnimatedBackground.astro";
import ProductCard from "@/components/ProductCard.astro";
import TeaserCard, { type TeaserVariant } from "@/components/TeaserCard.astro";
import { products, type ProductCategory } from "@/loaders/product";
import { SITE_URL } from "@/lib/site";

const SECTIONS: { category: ProductCategory; label: string; teaser: TeaserVariant; href?: string }[] =
  [
    { category: "saas", label: "In-House SaaS", teaser: "more-coming" },
    { category: "client", label: "Client Projects", teaser: "discuss", href: "/about#contact" },
    { category: "oss", label: "Open Source", teaser: "see-github" }
  ];

const rise = "--from-y: 100%; --duration: 0.3s";

// Cards pop in one after another in page order: each section's products, then its teaser
const order = SECTIONS.flatMap(({ category }) => [
  ...products.filter((p) => p.category === category).map((p) => p.name),
  `teaser:${category}`
]);
const cardIndex = (product: (typeof products)[number]) => order.indexOf(product.name);
const teaserIndex = (category: ProductCategory) => order.indexOf(`teaser:${category}`);

const itemList = {
  "@type": "ItemList",
  name: "Zaplytic products",
  itemListElement: products.map((product, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareApplication",
      name: product.name,
      description: product.description,
      applicationCategory: "BusinessApplication",
      ...(product.liveLink || product.githubLink
        ? { url: product.liveLink ?? product.githubLink }
        : {}),
      publisher: { "@id": `${SITE_URL}/#organization` }
    }
  }))
};
---

<BaseLayout
  title="Products"
  description="SaaS products, client projects and open-source tools built by Zaplytic — including ZapRoute, ZapMemo, AMC-Booster and RailGuard."
  jsonLd={[itemList]}
>
  <main>
    <AnimatedBackground />
    <div class="py-12 sm:py-16" data-testid="productspage">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <h1 style={rise} class="motion title text-3xl font-bold tracking-tight text-fg sm:text-4xl">Our Products</h1>
          <p style={rise} class="motion subtitle mt-6 text-lg leading-8 text-fg-muted">
            A showcase of our projects and experiments.
          </p>
        </div>

        {
          products.length === 0 ? (
            <p class="mt-16 text-center text-fg-subtle">No products yet.</p>
          ) : (
            SECTIONS.map(({ category, label, teaser, href }, s) => (
              <section class="mt-8 sm:mt-10" data-category={category}>
                <h3
                  style={`--i: ${s}; --from-x: -16px; --duration: 0.3s; --delay: 0.1s; --stagger: 0.1s`}
                  class="motion text-xs font-semibold uppercase tracking-[0.2em] text-fg-subtle"
                >
                  {label}
                </h3>
                <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                  {products
                    .filter((p) => p.category === category)
                    .map((product) => (
                      <ProductCard product={product} index={cardIndex(product)} />
                    ))}
                  <TeaserCard variant={teaser} href={href} index={teaserIndex(category)} />
                </div>
              </section>
            ))
          )
        }
      </div>
    </div>
  </main>
</BaseLayout>

