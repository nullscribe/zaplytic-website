---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSortedPosts } from "@/lib/blog";
import { SITE_URL } from "@/lib/site";

const posts = await getSortedPosts();

const blog = {
  "@type": "Blog",
  "@id": `${SITE_URL}/blog#blog`,
  url: `${SITE_URL}/blog`,
  name: "Zaplytic Blog",
  publisher: { "@id": `${SITE_URL}/#organization` },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: `${SITE_URL}/blog/${post.id}`,
    datePublished: post.data.date
  }))
};
---

<BaseLayout
  title="Blog"
  description="Engineering notes from Zaplytic on Rails, React, TypeScript, Postgres, architecture and building software in Bangladesh."
  jsonLd={[blog]}
>
  <main data-testid="blogindex" class="container mx-auto px-4 py-12 md:py-24">
    <div class="flex flex-col gap-8 max-w-2xl mx-auto">
      <!-- Visually hidden: gives the page its h1 for search and screen readers without changing the design -->
      <h1 class="sr-only">Blog</h1>
      {
        posts.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-fg-muted text-lg">No blog posts yet. Check back soon!</p>
          </div>
        ) : (
          posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="blogCard group block bg-bg-subtle rounded-xl shadow-lg hover:shadow-2xl transition-shadow duration-300 ease-in-out"
            >
              <article class="p-6">
                <h2 class="text-xl font-bold text-fg group-hover:text-blue-500 transition-colors duration-300">
                  {post.data.title}
                </h2>
                <p class="text-fg-muted mt-2">{post.data.description}</p>
                <time datetime={post.data.date} class="block text-fg-subtle text-sm mt-4">
                  {post.data.date}
                </time>
              </article>
            </a>
          ))
        )
      }
    </div>
  </main>
</BaseLayout>

<script>
  import { animateBlogIndex } from "@/scripts/animations";

  animateBlogIndex();
</script>
