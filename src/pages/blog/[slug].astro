---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSortedPosts, type BlogEntry } from "@/lib/blog";
import { SITE_NAME, SITE_URL } from "@/lib/site";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { title, description, date, author, tags } = post.data;
const { Content } = await render(post);
const url = `${SITE_URL}/blog/${post.id}`;

const blogPosting = {
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  mainEntityOfPage: url,
  url,
  headline: title,
  description,
  datePublished: date,
  dateModified: date,
  keywords: tags.join(", "),
  author: { "@type": "Person", name: author },
  publisher: { "@id": `${SITE_URL}/#organization` },
  isPartOf: { "@id": `${SITE_URL}/blog#blog` }
};

const breadcrumbs = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE_NAME, item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog` },
    { "@type": "ListItem", position: 3, name: title, item: url }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  article={{ publishedTime: date, author, tags }}
  jsonLd={[blogPosting, breadcrumbs]}
>
  <main data-testid="blogpost" class="py-12 md:py-24 text-fg">
    <div class="container mx-auto px-4">
      <article class="max-w-3xl mx-auto">
        <header class="text-center mb-8">
          <h1
            class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-fg mb-4"
          >
            {title}
          </h1>
          <div class="text-fg-muted">
            <span>By {author}</span>
            <span class="mx-2">&middot;</span>
            <time datetime={date}>{date}</time>
          </div>
        </header>

        <div class="prose lg:prose-xl mx-auto">
          <Content />
        </div>
      </article>
    </div>
  </main>
</BaseLayout>
