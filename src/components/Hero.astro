---
import { ROCKET_ICON } from "@/components/icons";

const words = ["Developers", "Businesses", "Founders"];
---

<div class="relative overflow-hidden">
  <div class="max-w-340 mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-24 pb-10">
    <div class="mt-5 max-w-3xl text-center mx-auto">
      <h1 class="block font-bold text-4xl md:text-5xl lg:text-6xl text-fg">
        <span id="hero-title-start">Empowering </span>
        <span
          id="hero-words"
          class="mr-2 inline-grid overflow-hidden justify-items-start *:col-start-1 *:col-end-2 *:row-start-1 *:row-end-2"
        >
          {
            words.map((word) => (
              <span class=" text-transparent bg-clip-text bg-linear-to-r from-cyan-500 to-lime-500">
                {word}
              </span>
            ))
          }
        </span>
        <span id="hero-title-end">with High-Quality Softwares</span>
      </h1>
    </div>

    <div class="mt-8 max-w-3xl text-center mx-auto">
      <p class="text-lg text-fg-muted" id="hero-subtitle">
        An independent product studio architecting robust and scalable SaaS systems,
        high-performance client solutions, and intuitive open-source tools.
      </p>
    </div>
    <div class="mt-16 gap-3 flex justify-center" id="hero-action">
      <a
        class="inline-flex justify-center items-center gap-x-3 text-center transition-colors duration-1000 bg-linear-to-l from-cyan-500 to-lime-500 hover:from-lime-500 hover:to-cyan-500 focus:from-lime-500 focus:to-cyan-500 focus:outline-none border border-transparent text-gray-900 text-sm font-medium rounded-full py-3 px-4"
        href="/products"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
          aria-hidden="true"
          focusable="false"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d={ROCKET_ICON}></path>
        </svg>
        Explore our Products
      </a>
    </div>
  </div>
</div>

<script>
  import { animateHero } from "@/scripts/animations";

  animateHero();
</script>
