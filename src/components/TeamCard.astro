---
import type { Member } from "@/loaders/team";

interface Props {
  member: Member;
  /** Position in the team list, for the staggered reveal */
  index?: number;
}

const ROLE_DOTS: Record<Member["role"], string> = {
  "Founder & Engineer": "bg-cyan-400",
  "Product R&D": "bg-lime-400",
  Design: "bg-emerald-400",
  "Corporate Relations": "bg-indigo-400"
};

const { member, index = 0 } = Astro.props;
---

<article
  style={`--i: ${index}; --from-y: 32px; --duration: 0.4s; --ease: var(--ease-out-cubic); --stagger: 0.1s`}
  class="motion-reveal teamcard group relative grid grid-cols-1 gap-2 py-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] sm:gap-8"
>
  <div class="flex items-center gap-3">
    <span class={`size-2 shrink-0 rounded-full ${ROLE_DOTS[member.role]}`} aria-hidden="true"></span>
    <h3
      style="--from-x: -20px"
      class="motion-reveal text-lg font-semibold tracking-tight text-fg transition-colors group-hover:text-fg">
      {member.name}
    </h3>
  </div>
  <div class="flex flex-col gap-1.5 sm:pl-6 sm:border-l sm:border-border">
    <span class="text-xs font-medium uppercase tracking-[0.18em] text-fg-subtle">
      {member.role}
    </span>
    <p class="max-w-xl text-sm leading-6 text-fg-muted">{member.bio}</p>
  </div>
</article>
