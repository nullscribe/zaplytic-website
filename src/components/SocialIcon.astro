---
import { SOCIAL_ICONS } from "@/components/icons";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "shrink-0 size-4" } = Astro.props;
const d = SOCIAL_ICONS[label];
---

{
  d && (
    <svg
      class={className}
      xmlns="http://www.w3.org/2000/svg"
      fill="currentColor"
      viewBox="0 0 16 16"
      aria-hidden="true"
    >
      <path d={d} />
    </svg>
  )
}
