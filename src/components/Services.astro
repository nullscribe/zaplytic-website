---
import ServiceCard from "@/components/ServiceCard.astro";
import { services } from "@/loaders/services";

const feature = services.find((s) => s.feature) ?? services[0];
const rest = services.filter((s) => s !== feature);
const card = (i: number) =>
  `--i: ${i}; --from-y: 24px; --ease: var(--ease-out-cubic); --stagger: 0.1s`;
---

<section id="services-section" data-reveal="80" class="max-w-7xl px-2 py-10 sm:px-4 lg:px-6 lg:py-14 mx-auto">
  <div class="max-w-2xl mx-auto text-center mb-10 lg:mb-14">
    <h2
      id="services-title"
      style="--from-y: 100%; --duration: 0.6s; --ease: var(--ease-out-quart)"
      class="motion-reveal text-3xl font-bold md:text-4xl md:leading-tight text-fg">
      What we can do for you
    </h2>
    <p class="mt-3 text-fg-muted text-base md:text-lg">
      Software made simple — built for businesses, shops, and people across Bangladesh.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2">
    <div class="motion-reveal service-card md:col-span-2 lg:col-span-2 lg:row-span-2" style={card(0)}>
      <ServiceCard service={feature} />
    </div>
    {
      rest.map((service, i) => (
        <div class="motion-reveal service-card" style={card(i + 1)}>
          <ServiceCard service={service} />
        </div>
      ))
    }
  </div>
</section>

<script>
  import { initReveal } from "@/scripts/reveal";

  initReveal();
</script>
