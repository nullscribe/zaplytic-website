---
// Label is set for light theme here and synced on load; icons switch via the `dark:` variant.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Switch to dark theme"
  class="size-9 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-full border border-transparent focus:outline-hidden text-fg-muted hover:bg-bg-hover focus:bg-bg-hover"
>
  <svg
    class="shrink-0 size-4 hidden dark:block"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="shrink-0 size-4 dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  import { initThemeToggle } from "@/scripts/theme";

  document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
    initThemeToggle(button);
  });
</script>
