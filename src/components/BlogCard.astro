---
import type { BlogSummary } from "@/lib/blog-types";

type Props = Pick<BlogSummary, "slug" | "title" | "tags">;

const { title, tags, slug } = Astro.props;
---

<a
  class="group flex flex-col border shadow-2xs rounded-xl hover:shadow-md focus:outline-hidden focus:shadow-md transition bg-bg-subtle border-border h-full"
  href={`/blog/${slug}`}
>
  <div class="p-4 md:p-5 flex flex-col grow justify-between">
    <div>
      <h3 class="text-xl font-semibold text-fg-muted group-hover:text-fg">{title}</h3>
    </div>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="inline-flex items-center py-0.5 px-2 rounded-full text-xs font-medium bg-bg-hover text-fg-muted">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
