{
  "name": "zaplytic-website",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:site": "vitest --project site",
    "test:visual": "playwright test",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "reset": "rm -rf node_modules && yarn install",
    "reset:hard": "rm -rf node_modules yarn.lock && yarn install"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12",
    "gsap": "^3.13.0",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "baseline-browser-mapping": "^2.11.1",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.39.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
